# ==========================================
# GitHub Heartbeat Bot - Configuration
# ==========================================

# Required: GitHub Personal Access Token (classic with 'repo' scope or fine-grained PAT with 'Read and Write' permissions for contents)
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# Required: Target Repository URL (HTTPS or SSH format)
# Example: https://github.com/your-username/your-repo.git
REPO_URL=https://github.com/your-username/your-repo.git

# Required: Target branch to push commits to
BRANCH_NAME=main

# Required: Git commit author identity
COMMIT_USERNAME=github-actions[bot]
COMMIT_EMAIL=github-actions[bot]@users.noreply.github.com

# ------------------------------------------
# Optional Settings
# ------------------------------------------

# Cron schedule (default: */10 * * * * = every 10 minutes)
# Format: minute hour day-of-month month day-of-week
CRON_SCHEDULE=*/10 * * * *

# Target directory to clone/manage repository (default: ./repo)
REPO_DIR=./repo

# Name of the file where heartbeats are logged (default: activity-log.txt)
LOG_FILE_NAME=activity-log.txt

# Run a heartbeat immediately upon startup (default: true)
RUN_ON_STARTUP=true

# Push retry policy
MAX_RETRIES=3
RETRY_DELAY_MS=2000
