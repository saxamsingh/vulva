# ==========================================
# GitHub Heartbeat Bot - Configuration
# ==========================================

# Required: GitHub Personal Access Token (classic with 'repo' scope or fine-grained PAT)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# Required: Target Repository URL (HTTPS or SSH format)
REPO_URL=https://github.com/your-username/your-repo.git

# Required: Target branch to push commits to
BRANCH_NAME=main

# Required: Git commit author identity
COMMIT_USERNAME=github-actions[bot]
COMMIT_EMAIL=github-actions[bot]@users.noreply.github.com

# ------------------------------------------
# Timing Configuration
# ------------------------------------------

# Enable natural randomized intervals between commits (default: true)
RANDOM_INTERVAL=true
MIN_INTERVAL_MINUTES=8
MAX_INTERVAL_MINUTES=12

# Fixed cron schedule fallback if RANDOM_INTERVAL=false (default: */10 * * * *)
CRON_SCHEDULE=*/10 * * * *

# ------------------------------------------
# Optional Settings
# ------------------------------------------

REPO_DIR=./repo
LOG_FILE_NAME=activity-log.txt
RUN_ON_STARTUP=true
MAX_RETRIES=3
RETRY_DELAY_MS=2000
